<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<meta name="referrer" content="no-referrer">
<title>Apple Fortune Bot</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}
html,body{width:100%;min-height:100vh;background:url('https://i.postimg.cc/8cZY1Pv7/file-00000000b1a071f49feec4d66d1499c5.png') center/cover no-repeat fixed #071c11!important;color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow-x:hidden}
.app{width:100%;max-width:410px;padding:8px;display:flex;flex-direction:column;align-items:center}
.reset-btn{position:fixed;top:15px;left:15px;width:38px;height:38px;border-radius:50%;background:rgba(10,38,20,.85);border:1px solid rgba(34,230,98,.3);display:flex;align-items:center;justify-content:center;cursor:pointer;color:#35d073;transition:all .3s;box-shadow:0 4px 10px rgba(0,0,0,.5);z-index:100;opacity:0;visibility:hidden;pointer-events:none}
.reset-btn.visible{opacity:1;visibility:visible;pointer-events:auto}
.reset-btn:hover{background:#22e662;color:#000;transform:rotate(180deg)}
.reset-btn svg,.menu-btn svg{width:20px;height:20px}
.menu-btn{position:fixed;top:15px;right:15px;width:38px;height:38px;border-radius:50%;background:rgba(10,38,20,.85);border:1px solid rgba(34,230,98,.3);display:flex;align-items:center;justify-content:center;cursor:pointer;color:#35d073;transition:all .3s;box-shadow:0 4px 10px rgba(0,0,0,.5);z-index:100}
.menu-btn:hover{background:#22e662;color:#000}
.overlay{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.6);backdrop-filter:blur(4px);z-index:200;opacity:0;visibility:hidden;pointer-events:none;transition:all .3s}
.overlay.active{opacity:1;visibility:visible;pointer-events:auto}
.drawer{position:fixed;top:0;right:0;width:290px;max-width:85%;height:100vh;background:rgba(7,28,17,.98);border-left:1px solid rgba(34,230,98,.3);padding:20px 16px 30px;box-shadow:-5px 0 25px rgba(0,0,0,.8);display:flex;flex-direction:column;gap:14px;transform:translateX(100%);transition:transform .3s ease-in-out;border-radius:20px 0 0 20px;overflow-y:auto}
.overlay.active .drawer{transform:translateX(0)}
.dhead{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid rgba(34,230,98,.2);padding-bottom:12px}
.dhead span{font-size:17px;font-weight:700;color:#22e662}
.dclose{background:none;border:none;color:#35d073;font-size:26px;cursor:pointer;line-height:1}
.dclose:hover{color:#22e662}
.profile-box{background:rgba(255,255,255,.05);border-radius:16px;border:1px solid rgba(34,230,98,.25);padding:14px;display:flex;flex-direction:column;align-items:center;gap:10px}
.avatar{width:58px;height:58px;border-radius:50%;background:rgba(34,230,98,.12);border:2px solid rgba(34,230,98,.4);display:flex;align-items:center;justify-content:center}
.avatar svg{width:30px;height:30px;fill:#35d073}
.pid-lbl{font-size:11px;color:#35d073;font-weight:600;letter-spacing:.5px;text-transform:uppercase;margin-bottom:4px}
.pid-val{font-size:15px;font-weight:700;color:#fff;margin-bottom:8px;text-align:center;min-height:22px}
.pid-val.empty{color:rgba(255,255,255,.3);font-size:12px;font-weight:400}
.irow{display:flex;gap:6px;width:100%}
.ifield{flex:1;background:rgba(0,0,0,.4);border:1px solid rgba(34,230,98,.3);border-radius:10px;color:#fff;font-size:13px;padding:8px 10px;outline:none;min-width:0}
.ifield::placeholder{color:rgba(255,255,255,.3)}
.ifield:focus{border-color:#22e662}
.ibtn{background:#22e662;color:#000;border:none;border-radius:10px;padding:8px 12px;font-size:12px;font-weight:700;cursor:pointer;white-space:nowrap;flex-shrink:0}
.ibtn:hover{background:#1acf56}
.mbody{display:flex;flex-direction:column;gap:10px}
.mitem{display:flex;align-items:center;gap:12px;padding:12px 14px;background:rgba(255,255,255,.04);border-radius:12px;color:#fff;font-size:14px;font-weight:600;border:1px solid rgba(34,230,98,.15);transition:all .2s;cursor:pointer}
.mitem:hover{background:rgba(34,230,98,.18);border-color:#22e662;color:#22e662;transform:translateX(-3px)}
.mitem svg{width:20px;height:20px;fill:currentColor;flex-shrink:0;opacity:.85}
/* Modal instructions */
.ioverlay{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.8);backdrop-filter:blur(4px);z-index:400;display:flex;align-items:center;justify-content:center;padding:16px;opacity:0;visibility:hidden;pointer-events:none;transition:all .3s}
.ioverlay.active{opacity:1;visibility:visible;pointer-events:auto}
.icard{background:rgba(7,28,17,.99);border:1px solid rgba(34,230,98,.3);border-radius:20px;width:100%;max-width:360px;max-height:88vh;overflow-y:auto;padding:20px 18px;display:flex;flex-direction:column;gap:14px}
.icard-head{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid rgba(34,230,98,.2);padding-bottom:12px}
.icard-head span{font-size:16px;font-weight:700;color:#22e662}
.icard-close{background:none;border:none;color:#35d073;font-size:24px;cursor:pointer;line-height:1}
.icard-close:hover{color:#22e662}
.step{display:flex;gap:10px;align-items:flex-start;background:rgba(255,255,255,.04);border-radius:12px;padding:10px 12px;border:1px solid rgba(34,230,98,.1)}
.snum{min-width:24px;height:24px;border-radius:50%;background:#22e662;color:#000;font-weight:700;font-size:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px}
.stxt{font-size:13px;color:rgba(255,255,255,.85);line-height:1.55}
.stxt strong{color:#22e662}
.simg{width:100%;border-radius:12px;overflow:hidden;border:1px solid rgba(34,230,98,.25);background:rgba(0,0,0,.3)}
.simg img{width:100%;display:block;border-radius:12px}
.warn{background:rgba(255,193,7,.08);border:1px solid rgba(255,193,7,.35);border-radius:12px;padding:12px;display:flex;gap:10px;align-items:flex-start}
.warn svg{width:22px;height:22px;fill:#ffc107;flex-shrink:0;margin-top:1px}
.warn p{font-size:12px;color:rgba(255,255,255,.85);line-height:1.6}
.warn p strong{color:#ffc107}
.slbl{font-size:11px;color:#35d073;font-weight:600;letter-spacing:.5px;text-transform:uppercase}
.blist{display:flex;flex-direction:column;gap:6px}
.bitem{display:flex;align-items:center;gap:8px;background:rgba(34,230,98,.07);border-radius:8px;padding:7px 10px;font-size:13px;color:#fff;border:1px solid rgba(34,230,98,.15)}
.bdot{width:8px;height:8px;border-radius:50%;background:#22e662;flex-shrink:0}
/* Popup ID requis */
.id-popup{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.8);backdrop-filter:blur(6px);z-index:500;display:flex;align-items:center;justify-content:center;padding:24px;opacity:0;visibility:hidden;pointer-events:none;transition:all .3s}
.id-popup.active{opacity:1;visibility:visible;pointer-events:auto}
.id-popup-card{background:rgba(7,28,17,.99);border:1px solid rgba(255,80,80,.4);border-radius:20px;padding:24px 20px;display:flex;flex-direction:column;align-items:center;gap:14px;max-width:300px;width:100%}
.id-popup-icon{width:56px;height:56px;border-radius:50%;background:rgba(255,80,80,.12);border:2px solid rgba(255,80,80,.4);display:flex;align-items:center;justify-content:center}
.id-popup-icon svg{width:28px;height:28px;fill:#ff5f5f}
.id-popup-title{font-size:17px;font-weight:700;color:#ff5f5f;text-align:center}
.id-popup-text{font-size:13px;color:rgba(255,255,255,.7);text-align:center;line-height:1.6}
.id-popup-btn{background:#22e662;color:#000;border:none;border-radius:12px;padding:12px 24px;font-size:14px;font-weight:700;cursor:pointer;width:100%}
.id-popup-btn:hover{background:#1acf56}
/* Grille */
.grid{display:flex;flex-direction:column;gap:6px;width:100%;margin-top:20px}
.row{display:flex;align-items:center;gap:6px}
.mult{width:62px;height:34px;border-radius:10px;background:rgba(10,38,20,.85);color:#35d073;font-weight:700;font-size:11px;display:flex;align-items:center;justify-content:center;border:1px solid rgba(34,230,98,.3);backdrop-filter:blur(4px);flex-shrink:0;cursor:pointer;user-select:none;transition:transform .1s,background .2s}
.mult:hover{transform:scale(1.05)}
.mult:active{transform:scale(.95)}
.row.predicted .mult{cursor:default;transform:none}
.row.active .mult{background:#22e662;color:#000;box-shadow:0 0 12px rgba(34,230,98,.8);border-color:#22e662}
.cells{display:flex;gap:4px;flex:1;justify-content:space-between}
.cell{width:100%;aspect-ratio:1;border-radius:50%;overflow:hidden;display:flex;align-items:center;justify-content:center;background:transparent;box-shadow:0 3px 6px rgba(0,0,0,.5)}
.cell img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.38);border-radius:50%}
@keyframes pulse{0%,100%{transform:scale(1.38)}50%{transform:scale(.85);opacity:.6}}
.animating img{animation:pulse .3s ease-in-out infinite}
</style>
</head>
<body>

<div class="reset-btn" id="rBtn"><svg viewBox="0 0 24 24"><path fill="currentColor" d="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/></svg></div>
<div class="menu-btn" id="mBtn"><svg viewBox="0 0 24 24"><path fill="currentColor" d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/></svg></div>

<!-- Drawer menu -->
<div class="overlay" id="menuOverlay">
  <div class="drawer">
    <div class="dhead"><span>Menu</span><button class="dclose" id="dClose">&times;</button></div>
    <div class="profile-box">
      <div class="avatar"><svg viewBox="0 0 24 24"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/></svg></div>
      <div style="width:100%;text-align:center">
        <div class="pid-lbl">Profil personnel</div>
        <div class="pid-val empty" id="pidVal">Aucun ID enregistré</div>
        <div class="irow">
          <input class="ifield" id="idField" type="text" placeholder="Ex : 1738518347" maxlength="30">
          <button class="ibtn" id="idOk">OK</button>
        </div>
      </div>
    </div>
    <div class="mbody">
      <div class="mitem" id="menuInstr">
        <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>Instructions
      </div>
      <div class="mitem" id="menuTg">
        <svg viewBox="0 0 24 24"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>Canal Telegram
      </div>
      <div class="mitem" id="menuAdmin">
        <svg viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z"/></svg>Contacter l'Admin
      </div>

    </div>
  </div>
</div>

<!-- Modal Instructions -->
<div class="ioverlay" id="instrOverlay">
  <div class="icard">
    <div class="icard-head">
      <span>📋 Comment utiliser le Bot</span>
      <button class="icard-close" id="instrClose">&times;</button>
    </div>

    <div class="step">
      <div class="snum">1</div>
      <div class="stxt">Ouvre ton bookmaker (<strong>1xBet, 888straz, LineBet</strong>...) et copie ton <strong>ID de compte</strong> visible dans ton profil personnel.</div>
    </div>
    <div class="simg">
      <img src="https://i.postimg.cc/QVLNLtK0/file-0000000028d48243bee2b61d130f3197.png" alt="ID bookmaker" loading="lazy" referrerpolicy="no-referrer">
    </div>

    <div class="step">
      <div class="snum">2</div>
      <div class="stxt">Entre cet ID dans la section <strong>Profil</strong> du menu ☰ en haut à droite, puis appuie sur <strong>OK</strong>. Sans ID enregistré, les signaux du Bot sont bloqués.</div>
    </div>

    <div class="step">
      <div class="snum">3</div>
      <div class="stxt">Sur l'écran principal, appuie sur le <strong>multiplicateur</strong> (ex : x2.41) pour lancer un signal. Les pommes <strong>vertes</strong> = cases sûres · <strong>bleues</strong> = cases à éviter.</div>
    </div>

    <div class="step">
      <div class="snum">4</div>
      <div class="stxt">⚠️ Pour <strong>plus de sécurité</strong>, récupère toujours tes gains dès la <strong>cote ×2</strong>. Ne continue jamais au-delà sans un nouveau signal confirmé du Bot.</div>
    </div>
    <div class="simg">
      <img src="https://i.postimg.cc/YqpMWJfx/Screenshot-20260917-165139.png" alt="Récupérer à la cote 2" loading="lazy" referrerpolicy="no-referrer">
    </div>

    <div class="warn">
      <svg viewBox="0 0 24 24"><path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/></svg>
      <p><strong>⚠️ Jeu responsable :</strong> Les paris d'argent comportent des risques importants de perte. Ne misez jamais plus que ce que vous pouvez vous permettre de perdre. Ce Bot est un outil d'aide à la décision, pas une garantie de gain. <strong>Jouez de manière responsable.</strong></p>
    </div>

    <div class="slbl">Bookmakers compatibles</div>
    <div class="blist">
      <div class="bitem"><div class="bdot"></div>1xBet</div>
      <div class="bitem"><div class="bdot"></div>888straz</div>
      <div class="bitem"><div class="bdot"></div>LineBet</div>
      <div class="bitem"><div class="bdot"></div>Autres plateformes compatibles</div>
    </div>
  </div>
</div>

<!-- Popup ID requis -->
<div class="id-popup" id="idPopup">
  <div class="id-popup-card">
    <div class="id-popup-icon">
      <svg viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
    </div>
    <div class="id-popup-title">ID requis</div>
    <div class="id-popup-text">Tu dois impérativement enregistrer ton <strong style="color:#22e662">ID de compte bookmaker</strong> avant de recevoir des signaux.<br><br>Appuie sur <strong style="color:#22e662">☰ Menu</strong> en haut à droite pour l'ajouter.</div>
    <button class="id-popup-btn" id="idPopupClose">Aller dans le Menu →</button>
  </div>
</div>

<div class="app"><div class="grid" id="grid"></div></div>

<script>
const mults=["x349.68","x69.93","x27.97","x11.18","x6.71","x4.02","x2.41","x1.93","x1.54","x1.23"],
iM="https://i.postimg.cc/630j05YZ/file-00000000ca807243931cb5921f70877d.png",
iG="https://i.postimg.cc/DwNP74Mw/file-000000009f8872438ad4cfad6a423a88.png",
iB="https://i.postimg.cc/fbXmZ2dg/file-0000000028f8724693118b0b4597e51d.png";
[iM,iG,iB].forEach(s=>{new Image().src=s});

const grid=document.getElementById("grid"),
rBtn=document.getElementById("rBtn"),
mBtn=document.getElementById("mBtn"),
menuOverlay=document.getElementById("menuOverlay"),
dClose=document.getElementById("dClose"),
idField=document.getElementById("idField"),
idOk=document.getElementById("idOk"),
pidVal=document.getElementById("pidVal"),
instrOverlay=document.getElementById("instrOverlay"),
instrClose=document.getElementById("instrClose"),
menuInstr=document.getElementById("menuInstr"),
menuTg=document.getElementById("menuTg"),
idPopup=document.getElementById("idPopup"),
idPopupClose=document.getElementById("idPopupClose");

let pRows=[],nextRow=1;

function hasId(){return !!localStorage.getItem("fuid")}

const sid=localStorage.getItem("fuid");
if(sid){pidVal.textContent="id: "+sid;pidVal.classList.remove("empty");idField.value=sid}

idOk.addEventListener("click",()=>{
  const v=idField.value.trim();
  if(!v)return;
  localStorage.setItem("fuid",v);
  pidVal.textContent="id: "+v;
  pidVal.classList.remove("empty");
  idOk.textContent="✓";
  setTimeout(()=>idOk.textContent="OK",1200);
});
idField.addEventListener("keydown",e=>{if(e.key==="Enter")idOk.click()});

mBtn.addEventListener("click",()=>menuOverlay.classList.add("active"));
dClose.addEventListener("click",()=>menuOverlay.classList.remove("active"));
menuOverlay.addEventListener("click",e=>{if(e.target===menuOverlay)menuOverlay.classList.remove("active")});

menuInstr.addEventListener("click",()=>{menuOverlay.classList.remove("active");instrOverlay.classList.add("active")});
instrClose.addEventListener("click",()=>instrOverlay.classList.remove("active"));
instrOverlay.addEventListener("click",e=>{if(e.target===instrOverlay)instrOverlay.classList.remove("active")});

menuTg.addEventListener("click",()=>{menuOverlay.classList.remove("active");window.open("https://t.me/winiaprono","_blank")});
document.getElementById("menuAdmin").addEventListener("click",()=>{menuOverlay.classList.remove("active");window.open("https://t.me/Jeuneroi120","_blank")});

idPopupClose.addEventListener("click",()=>{idPopup.classList.remove("active");menuOverlay.classList.add("active")});

function render(){
  grid.innerHTML="";pRows=[];nextRow=1;rBtn.classList.remove("visible");
  mults.forEach((m,i)=>{
    const r=10-i,d=document.createElement("div");
    d.className="row";d.dataset.row=r;
    let c="";
    for(let j=0;j<5;j++)c+=`<div class="cell" data-row="${r}"><img src="${iM}" referrerpolicy="no-referrer"></div>`;
    d.innerHTML=`<div class="mult" onclick="predict(${r})">${m}</div><div class="cells">${c}</div>`;
    grid.appendChild(d);
  });
}

function getB(r){return r<=4?1:r<=7?2:r<=9?3:4}

function predict(r){
  if(!hasId()){idPopup.classList.add("active");return}
  if(pRows.includes(r)||r!==nextRow)return;
  pRows.push(r);nextRow++;
  rBtn.classList.add("visible");
  document.querySelectorAll(".row").forEach(e=>e.classList.remove("active"));
  const el=document.querySelector(`.row[data-row="${r}"]`);
  if(el){el.classList.add("active","predicted")}
  const cells=Array.from(document.querySelectorAll(`.cell[data-row="${r}"]`));
  cells.forEach(c=>c.classList.add("animating"));
  setTimeout(()=>{
    cells.forEach(c=>c.classList.remove("animating"));
    const s=Math.floor(Math.random()*5),bC=getB(r),ind=[0,1,2,3,4].filter(i=>i!==s);
    ind.sort(()=>Math.random()-.5);
    const bI=ind.slice(0,bC);
    cells.forEach((c,i)=>{c.innerHTML=`<img src="${i===s||!bI.includes(i)?iG:iB}" referrerpolicy="no-referrer">`});
  },600);
}

rBtn.addEventListener("click",()=>{if(hasId())render()});
render();
</script>
</body>
</html>

